# Telegram — from https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Generated via generate_session.py on your local machine (treat like a password)
TELEGRAM_SESSION_STRING=

# Bot username without the @ (the Andrija bot you message on Telegram)
TELEGRAM_BOT_USERNAME=

# ElevenLabs — https://elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Random secret for iOS Shortcut auth — generate with:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_AUTH_TOKEN=

# Public HTTPS URL for this gateway (no trailing slash)
PUBLIC_BASE_URL=https://voice.jasenkoblazevic.from.hr

# How long to wait for Claude to reply before timing out
REPLY_TIMEOUT_SECONDS=60

# Optional — only needed for /voice/audio (push-to-talk Whisper path)
# OPENAI_API_KEY=

# Where to store generated MP3s (must match ReadWritePaths in systemd unit)
AUDIO_DIR=/tmp/voice-gateway
